generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestAuthType {
  SESSION
  API_KEY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleName {
  ADMIN
  USER
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_CHANGE_ABOVE
  PERCENT_CHANGE_BELOW
  RSI_ABOVE
  RSI_BELOW
}

enum ChannelProvider {
  WEB
  TELEGRAM
  DISCORD
}

enum NotificationCategory {
  SECURITY
  ACCOUNT
  ANNOUNCEMENT
  MARKET_ALERT
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnnouncementAudience {
  ALL
  USERS
  ADMINS
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id                 String                     @id @default(uuid()) @db.Uuid
  email              String                     @unique @db.VarChar(320)
  passwordHash       String                     @db.VarChar(255)
  name               String?                    @db.VarChar(120)
  status             UserStatus                 @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  roles              UserRole[]
  sessions           Session[]
  watchlists         Watchlist[]
  alerts             Alert[]
  channels           NotificationChannel[]
  apiKeys            ApiKey[]
  apiUsage           ApiUsage[]
  activity           ActivityLog[]
  aiRuns             AiRun[]
  notifications      Notification[]
  announcements      NotificationAnnouncement[] @relation("AnnouncementAuthor")
  botLinkTokens      BotLinkToken[]
  externalDeliveries ExternalDelivery[]
  subscription       Subscription?
  payments           BillingPayment[]
  quotaUsage         QuotaUsage[]
  tradePreferences   TradePreferences?
  aiSettings         AiSettings?
  journalEntries     JournalEntry[]

  @@index([status, createdAt])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  users     UserRole[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId, userId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Watchlist {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  name      String          @db.VarChar(80)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model WatchlistItem {
  id          String    @id @default(uuid()) @db.Uuid
  watchlistId String    @db.Uuid
  assetId     String    @db.VarChar(80)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
  @@index([watchlistId, position])
}

model Alert {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  name              String         @db.VarChar(120)
  assetId           String         @db.VarChar(80)
  condition         AlertCondition
  threshold         Decimal        @db.Decimal(24, 10)
  enabled           Boolean        @default(true)
  cooldownMinutes   Int            @default(60)
  interval          String         @default("15m") @db.VarChar(4)
  lastObservationAt DateTime?      @db.Timestamptz(3)
  lastValue         Decimal?       @db.Decimal(24, 10)
  matched           Boolean?
  evaluationReason  String?        @db.VarChar(80)
  triggers          AlertTrigger[]
  lastEvaluatedAt   DateTime?      @db.Timestamptz(3)
  lastTriggeredAt   DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, createdAt])
  @@index([enabled, assetId, interval])
}

model NotificationChannel {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  provider          ChannelProvider
  externalAccountId String?            @db.VarChar(200)
  displayName       String?            @db.VarChar(120)
  verifiedAt        DateTime?          @db.Timestamptz(3)
  active            Boolean            @default(false)
  preferences       Json               @default("{}")
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries        ExternalDelivery[]

  @@unique([provider, externalAccountId])
  @@unique([userId, provider])
  @@index([userId, active])
}

model ApiKey {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  name       String     @db.VarChar(80)
  prefix     String     @unique @db.VarChar(24)
  secretHash String     @db.Char(64)
  scopes     String[]   @default([])
  lastUsedAt DateTime?  @db.Timestamptz(3)
  expiresAt  DateTime?  @db.Timestamptz(3)
  revokedAt  DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage      ApiUsage[]

  @@index([userId, revokedAt, createdAt])
}

model ApiUsage {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  apiKeyId   String?         @db.Uuid
  authType   RequestAuthType @default(SESSION)
  requestId  String          @db.VarChar(80)
  route      String          @db.VarChar(160)
  method     String          @db.VarChar(12)
  statusCode Int
  latencyMs  Int
  occurredAt DateTime        @default(now()) @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey     ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([apiKeyId, occurredAt])
  @@index([requestId])
  @@index([authType, occurredAt])
  @@index([occurredAt])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  eventType   String   @db.VarChar(80)
  description String   @db.VarChar(240)
  metadata    Json     @default("{}")
  requestId   String?  @db.VarChar(80)
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
}

model NewsArticle {
  id                       String    @id @default(uuid()) @db.Uuid
  source                   String    @db.VarChar(80)
  title                    String    @db.VarChar(500)
  description              String?   @db.Text
  originalUrl              String    @db.Text
  canonicalUrlHash         String    @unique @db.Char(64)
  publishedAt              DateTime? @db.Timestamptz(3)
  fetchedAt                DateTime  @db.Timestamptz(3)
  language                 String?   @db.VarChar(16)
  sourceCategories         String[]  @default([])
  affectedAssets           String[]  @default([])
  category                 String?   @db.VarChar(80)
  priority                 Int?
  impactScore              Float?
  classificationConfidence Float?
  classifiedAt             DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  @@index([publishedAt, source])
  @@index([category, publishedAt])
  @@index([fetchedAt])
}

model Notification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid
  category       NotificationCategory
  severity       NotificationSeverity      @default(INFO)
  title          String                    @db.VarChar(120)
  body           String                    @db.VarChar(2000)
  actionPath     String?                   @db.VarChar(160)
  readAt         DateTime?                 @db.Timestamptz(3)
  archivedAt     DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  triggerId      String?                   @unique @db.Uuid
  announcementId String?                   @db.Uuid
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   NotificationAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: Restrict)

  @@unique([announcementId, userId])
  @@index([userId, archivedAt, readAt, createdAt])
  @@index([userId, category, createdAt])
}

model NotificationAnnouncement {
  id             String               @id @default(uuid()) @db.Uuid
  authorId       String?              @db.Uuid
  title          String               @db.VarChar(120)
  body           String               @db.VarChar(2000)
  actionPath     String?              @db.VarChar(160)
  severity       NotificationSeverity @default(INFO)
  audience       AnnouncementAudience @default(ALL)
  status         AnnouncementStatus   @default(DRAFT)
  recipientCount Int                  @default(0)
  excludedCount  Int                  @default(0)
  publishedAt    DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  author         User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model AiRun {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  requestId      String            @db.Uuid
  conversationId String            @db.Uuid
  input          String            @db.VarChar(2000)
  inputHash      String            @db.Char(64)
  purpose        String            @default("research") @db.VarChar(24)
  billingSource  String            @default("platform") @db.VarChar(12)
  archivedAt     DateTime?         @db.Timestamptz(3)
  deletedAt      DateTime?         @db.Timestamptz(3)
  tradeContext   Json?
  status         String            @db.VarChar(20)
  result         Json?
  errorCode      String?           @db.VarChar(80)
  model          String            @db.VarChar(200)
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  costUsd        Float?
  reservedUsd    Float             @default(0)
  toolCount      Int               @default(0)
  latencyMs      Int               @default(0)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime          @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals      AiAlertProposal[]

  @@unique([userId, requestId])
  @@index([userId, conversationId, createdAt])
  @@index([createdAt, status])
  @@index([expiresAt])
}

model AiAlertProposal {
  id        String         @id @default(uuid()) @db.Uuid
  runId     String         @unique @db.Uuid
  symbol    String         @db.VarChar(32)
  condition AlertCondition
  threshold Decimal        @db.Decimal(24, 10)
  state     String         @default("pending") @db.VarChar(20)
  alertId   String?        @db.Uuid
  expiresAt DateTime       @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  run       AiRun          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// A persisted observation is the recoverable outbox for evaluation queue publication.
model AlertObservation {
  id              String    @id @default(uuid()) @db.Uuid
  symbol          String    @db.VarChar(80)
  interval        String    @db.VarChar(4)
  payload         Json
  fetchedAt       DateTime  @db.Timestamptz(3)
  lastPublishedAt DateTime? @db.Timestamptz(3)
  failureCode     String?   @db.VarChar(80)
  completedAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@index([completedAt, lastPublishedAt, createdAt])
}

// Pending trigger rows are the transactional notification outbox.
model AlertTrigger {
  id                 String             @id @default(uuid()) @db.Uuid
  alertId            String             @db.Uuid
  userId             String             @db.Uuid
  observationAt      DateTime           @db.Timestamptz(3)
  triggeredAt        DateTime           @default(now()) @db.Timestamptz(3)
  assetId            String             @db.VarChar(80)
  condition          AlertCondition
  threshold          Decimal            @db.Decimal(24, 10)
  value              Decimal            @db.Decimal(24, 10)
  interval           String             @db.VarChar(4)
  source             String             @db.VarChar(80)
  providerSymbol     String             @db.VarChar(80)
  priceKind          String             @db.VarChar(20)
  unit               String             @db.VarChar(30)
  lastPublishedAt    DateTime?          @db.Timestamptz(3)
  failureCode        String?            @db.VarChar(80)
  deliveryStatus     String             @default("pending") @db.VarChar(20)
  deliveredAt        DateTime?          @db.Timestamptz(3)
  alert              Alert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  externalDeliveries ExternalDelivery[]

  @@unique([alertId, observationAt])
  @@index([userId, triggeredAt])
  @@index([deliveryStatus, lastPublishedAt, triggeredAt])
}

// Only a hash is stored. Redemption identifies a candidate; browser confirmation grants access.
model BotLinkToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  provider      ChannelProvider
  tokenHash     String          @unique @db.Char(64)
  expiresAt     DateTime        @db.Timestamptz(3)
  consumedAt    DateTime?       @db.Timestamptz(3)
  revokedAt     DateTime?       @db.Timestamptz(3)
  confirmedAt   DateTime?       @db.Timestamptz(3)
  candidateId   String?         @db.VarChar(200)
  candidateName String?         @db.VarChar(120)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@index([expiresAt])
}

model ExternalDelivery {
  id            String              @id @default(uuid()) @db.Uuid
  triggerId     String              @db.Uuid
  userId        String              @db.Uuid
  channelId     String              @db.Uuid
  provider      ChannelProvider
  destination   String              @db.VarChar(200)
  linkedAt      DateTime            @db.Timestamptz(3)
  status        String              @default("pending") @db.VarChar(20)
  attempts      Int                 @default(0)
  adminRetries  Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @db.Timestamptz(3)
  sendingAt     DateTime?           @db.Timestamptz(3)
  deliveredAt   DateTime?           @db.Timestamptz(3)
  receiptId     String?             @db.VarChar(200)
  failureCode   String?             @db.VarChar(80)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  trigger       AlertTrigger        @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([triggerId, channelId, destination])
  @@index([status, nextAttemptAt])
  @@index([userId, provider, createdAt])
}

// Platform tokens, link codes and command input are encrypted at rest and removed on expiry.
model BotCommand {
  id             String          @id @default(uuid()) @db.Uuid
  provider       ChannelProvider
  eventId        String          @db.VarChar(80)
  payload        String          @db.Text
  status         String          @default("pending") @db.VarChar(20)
  result         String?         @db.Text
  replyIndex     Int             @default(0)
  replyAttempts  Int             @default(0)
  nextAttemptAt  DateTime        @default(now()) @db.Timestamptz(3)
  failureCode    String?         @db.VarChar(80)
  requestId      String          @default(uuid()) @db.Uuid
  conversationId String          @default(uuid()) @db.Uuid
  leaseUntil     DateTime?       @db.Timestamptz(3)
  leaseOwner     String?         @db.Uuid
  sendingAt      DateTime?       @db.Timestamptz(3)
  expiresAt      DateTime        @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

model BotRuntime {
  provider     ChannelProvider @id
  inboundAt    DateTime?       @db.Timestamptz(3)
  checkedAt    DateTime?       @db.Timestamptz(3)
  successfulAt DateTime?       @db.Timestamptz(3)
  failureCode  String?         @db.VarChar(80)
}

enum PlanName {
  FREE
  PRO
}

enum BillingProvider {
  DEMO
  STRIPE_TEST
}

model Subscription {
  userId               String          @id @db.Uuid
  plan                 PlanName        @default(FREE)
  provider             BillingProvider @default(DEMO)
  status               String          @default("free") @db.VarChar(32)
  stripeCustomerId     String?         @unique @db.VarChar(120)
  stripeSubscriptionId String?         @unique @db.VarChar(120)
  currentPeriodEnd     DateTime?       @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean         @default(false)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingPayment {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  requestId        String          @db.Uuid
  provider         BillingProvider
  status           String          @default("pending") @db.VarChar(32)
  amountCents      Int             @default(0)
  currency         String          @default("usd") @db.VarChar(3)
  stripeSessionId  String?         @unique @db.VarChar(120)
  stripeInvoiceId  String?         @unique @db.VarChar(120)
  checkoutUrl      String?         @db.Text
  hostedInvoiceUrl String?         @db.Text
  paidAt           DateTime?       @db.Timestamptz(3)
  expiresAt        DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([provider, status, createdAt])
}

model QuotaUsage {
  userId    String   @db.Uuid
  day       String   @db.Char(10)
  resource  String   @db.VarChar(24)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, resource])
  @@index([day])
}

model TradePreferences {
  userId      String   @id @db.Uuid
  capital     Float?
  currency    String   @default("USD") @db.VarChar(3)
  riskPercent Float    @default(1)
  interval    String   @default("15m") @db.VarChar(4)
  holding     String   @default("day") @db.VarChar(12)
  autoReview  Boolean  @default(false)
  entryPolicy Json?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  runId            String?        @db.Uuid
  symbol           String         @db.VarChar(32)
  status           String         @default("planned") @db.VarChar(12)
  plan             Json
  context          Json
  analysis         Json
  source           String         @default("ai") @db.VarChar(12)
  trackingMode     String         @default("observed") @db.VarChar(12)
  entryTrigger     String         @default("touch") @db.VarChar(16)
  resultBasis      String         @default("recorded") @db.VarChar(12)
  targetAllocations Json           @default("[]")
  importKey        String?        @db.VarChar(64)
  archivedAt       DateTime?      @db.Timestamptz(3)
  notes            String         @default("") @db.VarChar(4000)
  entryPrice       Float?
  exitPrice        Float?
  quantity         Float?
  fees             Float          @default(0)
  openedAt         DateTime?      @db.Timestamptz(3)
  closedAt         DateTime?      @db.Timestamptz(3)
  checkedAt        DateTime?      @db.Timestamptz(3)
  monitoringStatus String?        @db.VarChar(160)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events           JournalEvent[]
  exits            JournalExit[]

  @@unique([userId, runId])
  @@unique([userId, importKey])
  @@index([userId, symbol, createdAt])
  @@index([status, checkedAt])
}

model JournalEvent {
  id              String       @id @default(uuid()) @db.Uuid
  entryId         String       @db.Uuid
  key             String       @db.VarChar(80)
  kind            String       @db.VarChar(20)
  occurredAt      DateTime     @db.Timestamptz(3)
  evidence        Json
  review          String?      @db.VarChar(2000)
  reviewStatus    String       @default("pending") @db.VarChar(20)
  reviewStartedAt DateTime?    @db.Timestamptz(3)
  entry           JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, key])
  @@index([entryId, occurredAt])
}

model AiSettings {
  userId        String   @id @db.Uuid
  language      String   @default("auto") @db.VarChar(8)
  memory        String   @default("") @db.VarChar(1200)
  source        String   @default("platform") @db.VarChar(12)
  encryptedKey  String?
  keyLast4      String?  @db.VarChar(4)
  modelId       String?  @db.VarChar(200)
  requestBudget Float    @default(1)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiModel {
  id                  String   @id @db.VarChar(200)
  name                String   @db.VarChar(300)
  contextLength       Int
  supportedParameters String[]
  promptPrice         Float
  completionPrice     Float
  requestPrice        Float
  compatible          Boolean
  active              Boolean  @default(true)
  syncedAt            DateTime @db.Timestamptz(3)

  @@index([active, compatible, name])
}

model JournalExit {
  id         String       @id @default(uuid()) @db.Uuid
  entryId    String       @db.Uuid
  key        String       @db.VarChar(80)
  price      Float
  quantity   Float
  fees       Float        @default(0)
  reason     String       @db.VarChar(16)
  basis      String       @db.VarChar(12)
  occurredAt DateTime     @db.Timestamptz(3)
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, key])
  @@index([entryId, occurredAt])
}
