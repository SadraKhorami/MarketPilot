NODE_ENV=production
# Set password-bearing URLs securely. Container DNS names are postgres and redis.
DATABASE_URL=
REDIS_URL=
WEB_ORIGIN=https://app.example.com
# Explicit proxy source IP/CIDR list. false trusts no forwarded headers.
TRUST_PROXY=false
NEWS_INGESTION_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
BOT_PAYLOAD_KEY=
BOT_WEB_URL=https://app.example.com

# Test billing only. Enabling demo gives users a free 30-day Pro activation.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_ID=
# Optional HTTPS API origin used by pnpm billing:setup-webhook.
BILLING_WEBHOOK_API_URL=

# 32-byte hex key for encrypting personal AI credentials; keep stable and secret.
AI_CREDENTIAL_KEY=
