# Copy outside the repository and use --env-file explicitly.
COMPOSE_PROJECT_NAME=marketpilot-staging
POSTGRES_DB=marketpilot
POSTGRES_USER=marketpilot
POSTGRES_PASSWORD_FILE=/secure/marketpilot-staging/postgres-password
REDIS_PASSWORD_FILE=/secure/marketpilot-staging/redis-password
API_ENV_FILE=/secure/marketpilot-staging/api.env
WORKER_ENV_FILE=/secure/marketpilot-staging/worker.env
MIGRATION_ENV_FILE=/secure/marketpilot-staging/migration.env
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.example.com
WEB_BIND_PORT=8080
API_BIND_PORT=8081
