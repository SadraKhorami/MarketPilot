NODE_ENV=development
DATABASE_URL=postgresql://marketpilot:marketpilot@localhost:5432/marketpilot?schema=public
REDIS_URL=redis://localhost:6379
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# No proxy is trusted by default. Production: explicit IP/CIDR allowlist only.
TRUST_PROXY=false
# Worker probe is private; production Compose overrides its host for internal checks.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4100

# Investing.com RSS content ingestion is disabled until its terms permit this use.
NEWS_INGESTION_ENABLED=false
NEWS_REFRESH_INTERVAL_SECONDS=900
INVESTING_RSS_FEEDS_JSON=[{"key":"forex","category":"Forex News","url":"https://www.investing.com/rss/news_1.rss"},{"key":"commodities","category":"Commodities & Futures News","url":"https://www.investing.com/rss/news_11.rss"},{"key":"stocks","category":"Stock Market News","url":"https://www.investing.com/rss/news_25.rss"},{"key":"indicators","category":"Economic Indicators News","url":"https://www.investing.com/rss/news_95.rss"},{"key":"economy","category":"Economy News","url":"https://www.investing.com/rss/news_14.rss"},{"key":"crypto","category":"Cryptocurrency News","url":"https://www.investing.com/rss/news_301.rss"},{"key":"companies","category":"Company News","url":"https://www.investing.com/rss/news_356.rss"}]

# Optional one-time local/admin bootstrap. Do not commit populated secrets.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Phase 4: server-only AI provider configuration. Select a real OpenRouter catalog model
# supporting tools, tool_choice and structured_outputs; no model/provider fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Phase 5: internal alert jobs. Restart workers after changing these values.
ALERT_REFRESH_SECONDS=60
ALERT_REFRESH_CONCURRENCY=2
ALERT_EVALUATION_CONCURRENCY=4
ALERT_NOTIFICATION_CONCURRENCY=4
ALERT_PROVIDER_JOBS_PER_MINUTE=20
ALERT_QUOTE_MAX_AGE_SECONDS=120
ALERT_SNAPSHOT_MAX_AGE_SECONDS=120
ALERT_JOB_ATTEMPTS=5

# Phase 6: server-only bot credentials. Configure securely; never paste populated secrets into chat.
# Webhook transport for both local development (HTTPS tunnel) and production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Independent 32-byte AES key as 64 hex characters; used for short-lived command payloads.
BOT_PAYLOAD_KEY=
# Dashboard origin, no path. HTTPS required in production.
BOT_WEB_URL=http://localhost:3000
# Public HTTPS API base URL used only by the explicit setup command, including /api/v1.
BOT_API_URL=

# Billing: disabled | demo (no credentials) | stripe_test (sandbox only; live keys rejected).
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_ID=
# Optional HTTPS API origin used by pnpm billing:setup-webhook.
BILLING_WEBHOOK_API_URL=

# 32-byte hex key for encrypting personal AI credentials; keep stable and secret.
AI_CREDENTIAL_KEY=
