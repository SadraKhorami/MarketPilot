{
  "name": "marketpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo run dev --filter=@marketpilot/api --filter=@marketpilot/web --filter=@marketpilot/worker",
    "dev:infra": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @marketpilot/db build",
    "db:migrate": "pnpm --filter @marketpilot/db migrate:dev",
    "db:seed": "pnpm --filter @marketpilot/db seed",
    "test": "turbo run test --filter=@marketpilot/api --filter=@marketpilot/market-data --filter=@marketpilot/news --filter=@marketpilot/ai --filter=@marketpilot/web",
    "build": "turbo run build --filter=@marketpilot/*",
    "lint": "turbo run lint --filter=@marketpilot/*",
    "format:check": "turbo run format:check --filter=@marketpilot/*",
    "typecheck": "turbo run typecheck --filter=@marketpilot/*",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "bots:setup": "node --env-file=.env packages/bots/dist/setup.js",
    "db:deploy": "pnpm --filter @marketpilot/db migrate:deploy",
    "billing:setup-webhook": "node --env-file=.env apps/api/scripts/setup-billing-webhook.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "10.26.0"
  }
}
