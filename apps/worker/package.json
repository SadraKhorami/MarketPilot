{
  "name": "@marketpilot/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "biome lint src",
    "format:check": "biome format src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@marketpilot/db": "workspace:*",
    "@marketpilot/market-data": "workspace:*",
    "@marketpilot/news": "workspace:*",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.4",
    "ioredis": "^5.6.1",
    "@marketpilot/jobs": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
